(function () {
  'use strict';

  // ---- CONFIG ----------------------------------------------------------
  // Params to carry forward.
  var PARAMS = ['msclkid', 'gclid'];

  // Domains to treat as internal. Any link whose hostname matches one of
  // these, or is a subdomain of one, gets decorated.
  // Add every domain in scope (e.g. 'anchore.com', 'anchore.io').
  var DOMAINS = ['anchore.com'];

  // If a link already has one of the params above, overwrite it?
  // false = keep the link's existing value (safer default).
  var OVERWRITE_EXISTING = false;
  // ----------------------------------------------------------------------

  function getParams() {
    var search = new URLSearchParams(window.location.search);
    var found = {};
    var has = false;

    PARAMS.forEach(function (name) {
      var value = search.get(name);
      if (value) {
        found[name] = value;
        has = true;
      }
    });

    return has ? found : null;
  }

  // Matches the domain itself or any subdomain of it.
  // 'anchore.com' matches anchore.com, www.anchore.com, info.anchore.com
  // but NOT notanchore.com
  function isInternalHost(hostname) {
    hostname = hostname.toLowerCase();
    for (var i = 0; i < DOMAINS.length; i++) {
      var domain = DOMAINS[i].toLowerCase();
      if (hostname === domain || hostname.slice(-(domain.length + 1)) === '.' + domain) {
        return true;
      }
    }
    return false;
  }

  function isInternalLink(anchor) {
    var href = anchor.getAttribute('href');
    if (!href) return false;
    if (href.charAt(0) === '#') return false;
    if (/^(mailto:|tel:|javascript:|sms:)/i.test(href)) return false;
    if (anchor.hasAttribute('download')) return false;

    try {
      var url = new URL(anchor.href, window.location.href);
      if (url.protocol !== 'http:' && url.protocol !== 'https:') return false;
      return isInternalHost(url.hostname);
    } catch (e) {
      return false;
    }
  }

  function decorate(anchor, params) {
    try {
      var url = new URL(anchor.href, window.location.href);
      var changed = false;

      Object.keys(params).forEach(function (name) {
        // Existing params on the link (utm_source, etc.) are always preserved.
        // This only decides what to do about a duplicate of OUR param.
        if (url.searchParams.has(name) && !OVERWRITE_EXISTING) return;
        if (url.searchParams.get(name) === params[name]) return;
        url.searchParams.set(name, params[name]);
        changed = true;
      });

      if (changed) anchor.href = url.toString();
    } catch (e) {
      // Malformed href — leave it alone.
    }
  }

  function decorateAll(params) {
    var anchors = document.querySelectorAll('a[href]');
    for (var i = 0; i < anchors.length; i++) {
      if (isInternalLink(anchors[i])) decorate(anchors[i], params);
    }
  }

  function init() {
    var params = getParams();
    if (!params) return;

    decorateAll(params);

    if (window.MutationObserver) {
      var pending = false;
      var observer = new MutationObserver(function () {
        if (pending) return;
        pending = true;
        window.setTimeout(function () {
          pending = false;
          decorateAll(params);
        }, 250);
      });
      observer.observe(document.body, { childList: true, subtree: true });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
