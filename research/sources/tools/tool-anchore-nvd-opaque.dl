<style id="wp-custom-css">
.btn.nav-btn:hover {
	color: #0D40B4;
	border-color: #0D40B4;
}

p.has-background {
	padding: 1.75em 2.375em !important;
}

.page-template-solutions-page hr {
	opacity: .2;	
}

.js-toggle-menu svg {
	filter: brightness(0.775);
}

#stick-nav .js-toggle-menu svg,
.home .js-toggle-menu svg,
.page-template-solutions-page .js-toggle-menu svg,
.page-template-cornerstone-page .js-toggle-menu svg,
.page-template-supporting-page .js-toggle-menu svg,
.js-toggle-menu.menu-toggle--open svg {
	filter: none;
}

@media only screen and (min-width: 768px) {
.half-hr-left {
	max-width: 47%;
	margin-right: auto;
}

.half-hr-right {
	max-width: 47%;
	margin-left: auto;
}
}

div#hs-eu-cookie-confirmation {
	position: fixed !important;
	bottom: 0 !important;
	top: unset !important;
}

div.wp-block-kevinbatdorf-code-block-pro:not(.code-block-pro-editor) pre code { 
    white-space: pre-wrap !important; 
    word-break: break-word !important;
    overflow-wrap: break-word !important; 
    padding: 0 2rem 0 max(var(--cbp-line-number-width), 2rem) !important; 
}

body.page-id-1131 .open-source-action-sec .box_open_source:nth-child(2) header .gatsby-image-wrapper img {
	height: 81px;
}

body.page-id-1131 .open-source-action-sec .animated-svg-highlights {
	row-gap: 25px;
	justify-content: center;
}

body.case_study_template_new blockquote {
	    padding-left: 0;
    margin-top: 32px;
}

body.case_study_template_new blockquote p {
	    font-size: 20px;
    line-height: 32px;
    color: #10AF80;
}

body.case_study_template_new blockquote cite {
	    font-size: 20px;
    line-height: 32px;
    color: #10AF80;
}

body.case_study_template_new .post-wrapper blockquote:before {
	display: none;
}

body.case_study_template_new mark {
	padding: 0;
}

body.case_study_template_new .hero-blog-single .post-meta-wrap {
	display: none;
}

@media (max-width: 768px) {
	body.case_study_template_new blockquote p,
	body.case_study_template_new blockquote cite {
		        font-size: 18px;
        line-height: 28px;
	}
}
.page-id-987475194 section#sec-3 {
    padding-bottom: 100px;
}
.page-id-987475194 #sec-3 h3.headline-2-sm{
    font-size: 38px;
    line-height: 38px;
}
@media (max-width: 450px) {
.page-id-987475194 #sec-3 h3.headline-2-sm{
    font-size: 30px;
    line-height: 30px;
}
}

@media (min-width: 450px) {
.single-post .post-meta-wrap {
    min-width: 370px;
}
}
